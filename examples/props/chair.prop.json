{
  "name": "chair",
  "description": "Straight-backed chair; its seat height and width are parameters",
  "tags": ["furniture", "seating"],
  "params": {
    "width": {"default": 0.46, "min": 0.34, "max": 0.7, "description": "Seat width and depth"},
    "seat_height": {"default": 0.46, "min": 0.3, "max": 0.8}
  },
  "slots": {"seat": "studio.velvet.plum", "frame": "stock.wood.oak"},
  "parts": [
    {"solid": "box", "size": ["width", 0.06, "width"], "at": [0, "seat_height", 0], "shader": "seat"},
    {"solid": "box", "size": ["width", 0.45, 0.04], "at": [0, "seat_height + 0.26", "width / 2 - 0.02"], "shader": "frame"},
    {"repeat": 4, "as": "i", "parts": [
      {"solid": "box", "size": [0.04, "seat_height - 0.02", 0.04], "shader": "frame",
       "at": ["(i % 2 * 2 - 1) * (width / 2 - 0.03)", "(seat_height - 0.02) / 2", "(i // 2 * 2 - 1) * (width / 2 - 0.03)"]}
    ]}
  ]
}
